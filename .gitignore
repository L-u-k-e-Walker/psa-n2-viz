__pycache__/
*.pyc
.pytest_cache/
*.log
scratch/
# rendered frames and the physics/frame caches (rebuildable)
frames/
**/frames/
cache/
**/cache/
# previews: only contact sheets and config snapshots are committed
previews/**
!previews/*/
!previews/*/contact_*.png
!previews/*/config_*.toml
# intermediate CSS / sizing runs (final states are committed from model/css/final and model/grid/2N)
model/**/runs/
*.out
model/**/runs_*/
model/sizing/*.npy
model/phase1_final.draft_done
